{
	admin off
	auto_https off
	persist_config off
}

# Listens on localhost only, for any Host header (tailscale serve forwards the tailnet
# hostname). Expose to the tailnet with: sudo tailscale serve --bg --http=8080 http://127.0.0.1:8080
http://:8080 {
	bind 127.0.0.1
	encode gzip
	handle_path /_pdfs/* {
		root * /home/user/vault/_pdfs
		# Stored web snapshots must not run scripts on the wiki's origin.
		header Content-Security-Policy "sandbox"
		file_server
	}
	# Web UI (password-protected by the app itself)
	handle /app/* {
		request_body {
			max_size 80MB
		}
		reverse_proxy 127.0.0.1:8081
	}
	handle /app {
		redir /app/ 308
	}
	handle {
		root * /home/user/litwiki/site/current
		file_server
	}
	handle_errors {
		rewrite * /404.html
		root * /home/user/litwiki/site/current
		file_server
	}
	log {
		output file /home/user/litwiki/logs/caddy.log {
			roll_size 5MiB
			roll_keep 2
		}
	}
}
