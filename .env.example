# Copy to ~/.env and `chmod 600 ~/.env`. litwiki reads it at startup; never commit it.

# Required
ZOTERO_API_KEY=          # zotero.org -> Settings -> Feeds/API -> create a key with READ-ONLY access to your library
ANTHROPIC_API_KEY=       # console.anthropic.com. Without it `claude -p` falls back to a subscription login and hits its session limit
LITWIKI_WEB_PASSWORD=    # password for the /app/ web UI (any long random string)

# Optional
DISCORD_WEBHOOK_URL=     # simple notifications (digests, budget alerts)
DISCORD_BOT_TOKEN=       # interactive bot with buttons and slash commands (see README)
